# 模型提供方：anthropic | deepseek
LLM_PROVIDER=anthropic
# —— Anthropic（默认）
ANTHROPIC_API_KEY=              # 留空则由 `ant auth login` 的 profile 解析
CLAUDE_MODEL=claude-opus-5
PLAN_EFFORT=high                # 两家通用：low/medium/high/xhigh/max（DeepSeek 把 medium/xhigh 归到 high）
# —— DeepSeek（LLM_PROVIDER=deepseek 时生效；走 Anthropic 兼容端点，复用同一 SDK）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro  # 或 deepseek-v4-flash（更便宜，抽取准确率需实测）
LLM_CA_BUNDLE=                  # 通常留空；企业代理/自签 CA 环境可填系统 CA bundle 路径
DEEPSEEK_THINKING=false          # true 会开思考但只能 tool_choice=auto（DeepSeek 限制），结构合规靠重试兜底
DEEPSEEK_MAX_ATTEMPTS=3         # 结构不合规时的总尝试次数

# 数据库
#   有 Docker：docker compose up -d 后用下面这条
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/travel
#   无 Docker：用内嵌 PostgreSQL 16（pgserver），数据目录 .pgdata/
# DATABASE_URL=embedded:///.pgdata

# 约束阈值（手册 [A]：不硬编码）
COMMUTE_MAX_MIN=180
COMMUTE_MAX_MIN_TRANSFER=300
PRICE_STALENESS_DAYS=90
RESOURCE_STALENESS_DAYS=180

# 编排
PLANNER_MODE=llm
DEMO_MODE=true                   # M0 演示环境；生产必须设为 false
DEMO_SAFE_DATE=2026-10-15        # 候选不足时提供的一键恢复日期
MAX_REPLAN_ROUNDS=3
COMPLETENESS_THRESHOLD=0.85
GENERATION_TIMEOUT_SEC=300

# 成本
SERVICE_FEE_RATE=0.08
FX_JPY_CNY=0.0479

# 排序权重（商业优先级上限锁死 0.10，见 core/config.py 的 validator）
W_TAG_MATCH=0.50
W_PRICE_FIT=0.30
W_FRESHNESS=0.20
W_COMMERCIAL=0.00

# 服务
API_PORT=8000
LOG_LEVEL=INFO

# API 鉴权（本地演示可保持 false；部署环境应开启并使用每人独立的高熵 Key）
AUTH_ENABLED=false
# JSON 必须单行；Key 至少 16 字符。角色：sales / advisor / supervisor / procurement / admin
API_KEYS_JSON={"replace-with-random-key":{"user_id":"advisor-01","role":"advisor"}}
LOCAL_USER_ID=local-advisor
LOCAL_ROLE=advisor

# 无需输入 API Key 的公开演示（仅模拟数据）；签名密钥必须至少 32 字符。
PUBLIC_DEMO=false
DEMO_SESSION_SECRET=
LLM_BUDGET_ENABLED=false
LLM_DAILY_TOKEN_LIMIT=500000
LLM_DAILY_CALL_LIMIT=60
LLM_CALLS_PER_MINUTE=6
LLM_MAX_CONCURRENCY=1
LLM_INPUT_TOKEN_LIMIT=40000
LLM_EXTRACT_OUTPUT_LIMIT=1500
LLM_GUIDANCE_OUTPUT_LIMIT=800
LLM_PLAN_OUTPUT_LIMIT=6000
